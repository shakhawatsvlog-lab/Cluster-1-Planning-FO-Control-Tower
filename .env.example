# ==============================================================================
# ALEX APPARELS CONTROL TOWER — DEPLOYMENT ENVIRONMENT CHECKLIST
# ==============================================================================
# 0. Reversible Feature Flags (Set to "true" to re-enable AI / Email when ready)
AI_ENABLED="false"
EMAIL_ENABLED="false"

# 1. Server-side Gemini AI Key (NEVER expose in VITE_* or client code)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 2. Admin Authentication & Signed Session Secret
# Set a strong admin password if deploying on an ephemeral/fresh filesystem.
# Leave unset only if setting the initial password via the web Control Panel setup.
ADMIN_PASSWORD=""
# Cryptographically random >=32-char secret for signing HttpOnly admin session cookies.
SESSION_SECRET=""
# Admin verification/recovery email used for OTP password changes.
ADMIN_RECOVERY_EMAIL=""

# 3. Hosting URL & CORS Origin Allowlist
APP_URL="https://cluster-1-planning-fo-control-tower-9b844.containers.snapdeploy.app"
# Comma-separated list of additional trusted web origins (e.g., GitHub Pages frontend)
ALLOWED_ORIGINS="https://shakhawatsvlog-lab.github.io"
NODE_ENV="production"

# 4. SMTP Email Configuration (Optional: also configurable inside Control Panel -> Daily Email)
# For Gmail, use smtp.gmail.com (port 465, secure=true) with a Google App Password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Alex Apparels Planning <noreply@example.com>"
